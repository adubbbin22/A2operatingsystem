# Copy to .env and fill in. .env is gitignored — never commit real keys.
# Referenced by .mcp.json as ${VAR}.

# --- Nano Banana (Gemini image generation) ---
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# --- Meta Ads (via Pipeboard) ---
# Sign up at https://pipeboard.co, connect your Meta ad account, copy the token.
PIPEBOARD_TOKEN=

# --- RevenueCat ---
# Project settings → API keys → v2 secret key
REVENUECAT_V2_SECRET_KEY=

# --- Apple Search Ads ---
# Apple Ads UI → Account Settings → API. Store the private key as a single line (\n-escaped) or a path per the server's README.
APPLE_ADS_CLIENT_ID=
APPLE_ADS_TEAM_ID=
APPLE_ADS_KEY_ID=
APPLE_ADS_PRIVATE_KEY=

# --- App Store Connect (iOS metadata / versions / TestFlight) ---
# App Store Connect → Users and Access → Integrations → App Store Connect API
ASC_KEY_ID=
ASC_ISSUER_ID=
ASC_PRIVATE_KEY_PATH=./secrets/AuthKey_XXXXXX.p8

# --- Google Ads (reporting) ---
# Developer token from your Google Ads manager account; OAuth client + refresh token.
GOOGLE_ADS_DEVELOPER_TOKEN=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=

# --- Google Play Console ---
# Play Console → Setup → API access → service account JSON (path or inline JSON per server README).
GOOGLE_PLAY_SERVICE_ACCOUNT_JSON=./secrets/play-service-account.json

# --- Firebase Analytics via BigQuery (DAU / retention / events for the store apps) ---
# The Firebase console has no metrics API — the supported path is the BigQuery export:
# 1. Log into the Google account that owns the Firebase projects (awagnertrugman@gmail.com?)
#    and in EACH Firebase project: Project settings → Integrations → BigQuery → Link
#    (enable the Google Analytics export; daily export is free tier).
# 2. In Google Cloud console (same account): IAM & Admin → Service Accounts → create one,
#    grant "BigQuery Job User" on the project + "BigQuery Data Viewer" on the analytics_*
#    datasets, create a JSON key, save it to ./secrets/bigquery-service-account.json.
# 3. Fill these in; the bigquery MCP server in .mcp.json connects on next session start.
BIGQUERY_PROJECT_ID=
GOOGLE_APPLICATION_CREDENTIALS=./secrets/bigquery-service-account.json
